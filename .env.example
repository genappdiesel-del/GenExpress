# ---------------------------------------------------------------
# Supabase keys — where to find them
# ---------------------------------------------------------------
# 1. Go to https://supabase.com and open your project
# 2. Click the gear icon (Project Settings) at the bottom of the left menu
# 3. Click "API" in the left sidebar
# 4. Copy the two values below
#
# Both of these are SAFE to put in this file and in the repository.
# They are designed to be visible in browser code. The database itself
# is protected by Row Level Security (RLS), not by hiding these keys.
#
# NEVER put the service_role key in this file. It bypasses all security.

# Your project URL. Looks like: https://abcdefghijklm.supabase.co
# Where to find it: same page as above, top of the "Project URL" box
VITE_SUPABASE_URL=

# The "anon" or "publishable" key. A long string starting with "eyJ" or "sb_".
# Where to find it: same page, in "Project API keys"
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Supabase CLI — for running SQL migrations from your computer
# ---------------------------------------------------------------
# These are NOT used by the website. They are only needed if you want to
# push database changes with `supabase db push`.
#
# Where to find the access token:
#   Go to https://supabase.com/dashboard/account/tokens
#   Click "Generate new token". Name it "my-computer".
#   Copy it once — you cannot see it again.
#   It starts with "sbp_".
#
# NEVER put this token in this file or in the repository.
SUPABASE_ACCESS_TOKEN=

# Your project reference. This is the short code in your project URL.
# https://abcdefghijklm.supabase.co  ->  abcdefghijklm
SUPABASE_PROJECT_REF=